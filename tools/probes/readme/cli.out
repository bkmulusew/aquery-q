== -parse
List
  - Query @1:1
    local: []
    main: Project @1:1
      t: GroupBy
        t: Filter
          t: Table @2:6
            n: "t"
            alias: None
          fs: List
            - BinExpr @3:7
              op: Gt
              l: Id @3:7
                v: "a"
              r: IntLit @3:11
                v: 1
        gs: List
          - Tuple
            _1: Id @4:10
              v: "a"
            _2: None
        having: []
      ps: List
        - Tuple
          _1: Id @1:8
            v: "a"
          _2: None
        - Tuple
          _1: FunCall @1:11
            f: "SUM"
            args: List
              - Id @1:15
                v: "b"
          _2: Some
            value: "total"
== -p
