// paper_queries.a - the AQuery examples from the AQueryKDB paper, as a test.
//
// The file is cut into parts. A line starting with "// === " begins a part:
//   // === setup: ...    creates the tables the queries after it use
//   // === query: ...    one query from the paper
//   // === skipped: ...  kept for later, not run
// Under a query, a line "// expect: <q code>" gives the right answer as a q
// value. tests/paper/run_paper.q runs a part and compares its result with it.
//
// Run it in L, from the aquery-q folder:
//   bin/l_m64 aquery.q
//   \l tests/paper/run_paper.q
//   .paper.list[]       / the parts
//   .paper.run 4        / run part 4 (and the setup above it)
//   .paper.runAll[]     / run every part, one row per part
//
// Where the paper's text has a mistake, the part "as printed" keeps the
// paper's text and the next part "(fixed)" has the corrected query.
// The paper writes quotes as LaTeX ``IBM''; here they are "IBM".
// Dates in AQuery are written 'MM/DD/YYYY' in single quotes.

// === setup: Section 3.1 tables prices, sales, dividends ===
// Three small tables for the join examples. Only dividends has no date,
// so the first join is by Id and the second by TradeDate.
CREATE TABLE prices (TradeDate DATE, price FLOAT)
INSERT INTO prices VALUES('01/02/2014', 100.0)
INSERT INTO prices VALUES('01/03/2014', 101.0)
INSERT INTO prices VALUES('01/06/2014', 99.5)

CREATE TABLE sales (Id STRING, TradeDate DATE, volume INT)
INSERT INTO sales VALUES("A", '01/02/2014', 10)
INSERT INTO sales VALUES("B", '01/02/2014', 20)
INSERT INTO sales VALUES("A", '01/03/2014', 30)
INSERT INTO sales VALUES("C", '01/06/2014', 40)

CREATE TABLE dividends (Id STRING, DivAmt FLOAT)
INSERT INTO dividends VALUES("A", 0.5)
INSERT INTO dividends VALUES("B", 0.25)

// === query: Section 3.1, three-way join (as printed) ===
// The paper nests the joins: sales with dividends first, then prices.
// AQuery's grammar only chains joins left to right, so this does not parse.
SELECT *
FROM
prices INNER JOIN
     sales INNER JOIN dividends USING Id
USING TradeDate

// === query: Section 3.1, three-way join (fixed) ===
// The same join chained left to right. sales row C has no dividend, so
// 3 rows remain: (A, 01/02, 10), (B, 01/02, 20), (A, 01/03, 30), each with
// its dividend and that day's price.
SELECT *
FROM prices INNER JOIN sales USING TradeDate INNER JOIN dividends USING Id
// expect: 3

// === query: Section 3.1, join written as a cross product ===
// Same 3 rows as the fixed join above.
SELECT *
FROM prices, sales, dividends
WHERE sales.Id = dividends.Id AND prices.TradeDate = sales.TradeDate
// expect: 3

// === setup: Section 3.2 and 3.4 table network (Figure 2) ===
// The 4 rows of Figure 2. 04/01/15 is April 1, 2015.
CREATE TABLE network (base_station INT, date DATE, hour_stamp INT, num_conns INT)
INSERT INTO network VALUES(1, '04/01/2015', 1, 10)
INSERT INTO network VALUES(1, '04/01/2015', 2, 20)
INSERT INTO network VALUES(2, '04/01/2015', 1, 30)
INSERT INTO network VALUES(2, '04/01/2015', 2, 40)

// === query: Figure 1, moving average (as printed) ===
// avgs takes the window size first: avgs(24, num_conns). Written this way,
// the column is used as the window size.
SELECT avgs(num_conns, 24)
FROM network
ASSUMING ASC date, ASC hour_stamp
WHERE base_station=1

// === query: Figure 1, moving average (fixed) ===
// Station 1 has 10 then 20 connections: the averages are 10 and 15.
SELECT avgs(24, num_conns)
FROM network
ASSUMING ASC date, ASC hour_stamp
WHERE base_station=1
// expect: ([] m:10 15f)

// === query: Section 3.4, GROUP BY makes a nested table (Figure 2) ===
// One row per station; the other columns become lists, as in Figure 2.
SELECT base_station, date, hour_stamp, num_conns
FROM network
GROUP BY base_station
// expect: ([] base_station:1 2; date:(2#2015.04.01;2#2015.04.01); hour_stamp:(1 2;1 2); num_conns:(10 20;30 40))

// === query: Figure 3, HAVING ===
// Station 1 has 10+20=30 connections, station 2 has 30+40=70.
// Only station 2 has at least 50. The paper's answer: station 2, count 2.
SELECT base_station,
COUNT(*) as ct
FROM network
GROUP BY base_station
HAVING sum(num_conns) >= 50
// expect: ([] base_station:enlist 2; ct:enlist 2)

// === setup: Section 3.3 table stocks ===
// The paper's 3 rows (ticker, date, price). The paper gives no volume; we
// add one so the two queries below give different answers.
CREATE TABLE stocks (ticker STRING, TradeDate DATE, price INT, volume INT)
INSERT INTO stocks VALUES("HP", '11/16/2015', 100, 500)
INSERT INTO stocks VALUES("IBM", '11/17/2015', 150, 900)
INSERT INTO stocks VALUES("IBM", '11/18/2015', 170, 300)

// === query: Section 3.3, ticker test first ===
// First keep the IBM rows (150, 170); then price > prev(price) keeps only
// 170, because the first IBM row has no previous row. max(volume) = 300.
// That is the paper's answer. q (kdb+ and L) gives 900: there the first
// row's prev is a null, and q counts a null as smaller than every number,
// so 150 > null is true and both IBM rows stay.
SELECT max(volume)
FROM stocks
ASSUMING ASC TradeDate
WHERE
ticker = "IBM" AND price>prev(price)
// expect: ([] m:enlist 900)

// === query: Section 3.3, price test first ===
// First price > prev(price) keeps 150 and 170; both are IBM.
// max(volume) = 900.
SELECT max(volume)
FROM stocks
ASSUMING ASC TradeDate
WHERE
price>prev(price) AND ticker = "IBM"
// expect: ([] m:enlist 900)

// === setup: Section 3.6 tables sales and prices for WITH ===
// New sales and prices tables (different columns from Section 3.1).
CREATE TABLE sales (Id STRING, TradeDate DATE, volume INT)
INSERT INTO sales VALUES("A", '12/20/2013', 800)
INSERT INTO sales VALUES("A", '03/15/2014', 100)
INSERT INTO sales VALUES("B", '06/30/2014', 200)
INSERT INTO sales VALUES("A", '12/31/2014', 50)
INSERT INTO sales VALUES("B", '01/05/2015', 400)

CREATE TABLE prices (Id STRING, price FLOAT)
INSERT INTO prices VALUES("A", 150.0)
INSERT INTO prices VALUES("B", 90.0)

// === query: Section 3.6, WITH (as printed) ===
// The dates are in double quotes, so they are text, not dates, and q
// cannot compare a date column with text.
WITH
  y14 AS (
       SELECT *
       FROM sales
       WHERE TradeDate BETWEEN "01/01/2014" AND "12/31/2014"
       )

SELECT sum(volume)
FROM y14 INNER JOIN prices USING Id
WHERE price > 100

// === query: Section 3.6, WITH (fixed) ===
// 2014 sales: A 100, B 200, A 50. Only A's price is over 100: 100+50 = 150.
WITH
  y14 AS (
       SELECT *
       FROM sales
       WHERE TradeDate BETWEEN '01/01/2014' AND '12/31/2014'
       )

SELECT sum(volume)
FROM y14 INNER JOIN prices USING Id
WHERE price > 100
// expect: ([] s:enlist 150)

// === setup: Section 3.6 table prices for EXEC ARRAYS ===
// Rows are inserted out of date order, so ASSUMING has work to do.
CREATE TABLE prices (TradeDate DATE, px FLOAT)
INSERT INTO prices VALUES('01/03/2014', 12.0)
INSERT INTO prices VALUES('01/01/2014', 10.0)
INSERT INTO prices VALUES('01/04/2014', 13.0)
INSERT INTO prices VALUES('01/02/2014', 11.0)

// === query: Section 3.6, EXEC ARRAYS (as printed) ===
// Two problems: EXEC ARRAYS needs the query in parentheses, and avgs
// takes the window size first.
EXEC ARRAYS
SELECT avgs(px, 7) as moving_average
FROM prices
ASSUMING ASC TradeDate

// === query: Section 3.6, EXEC ARRAYS (fixed) ===
// Makes the q variable moving_average. Sorted px is 10 11 12 13, so the
// running averages are 10 10.5 11 11.5. The <q> line shows the variable.
EXEC ARRAYS (
SELECT avgs(7, px) as moving_average
FROM prices
ASSUMING ASC TradeDate
)
<q> moving_average </q>
// expect: 10 10.5 11 11.5

