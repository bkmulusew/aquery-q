CREATE TABLE split (Id STRING, SplitDate DATE, EntryDate DATE, SplitFactor INT)
INSERT INTO split VALUES("A", '08/05/2016', '07/20/2016', 2)
INSERT INTO split VALUES("C", '08/10/2016', '07/25/2016', 3)

CREATE TABLE dividend (Id STRING, XdivDate DATE, DivAmt FLOAT, AnnounceDate DATE)
INSERT INTO dividend VALUES("B", '12/01/2015', 0.4, '11/15/2015')
INSERT INTO dividend VALUES("B", '08/03/2016', 0.5, '07/15/2016')
INSERT INTO dividend VALUES("A", '08/09/2016', 0.3, '07/28/2016')
INSERT INTO dividend VALUES("D", '08/08/2016', 1.0, '07/25/2016')

// The benchmark settings are plain q variables, not tables, so they are set
// in a <q> block, as in the paper's own loader (financial/load.a). Its
// values are random; ours are fixed so the answers never change.
<q>
/ the stock sets: a list of Ids each (` makes a symbol, `A`B`C is 3 of them)
stock10:`A`B`C;
stock1000:`A`B`C;
SP500:`A`B;
Russell2000:`B`C`D;

/ the dates (q writes dates as year.month.day)
startYear10:2015.08.03;
start300Days:2016.08.01;
startPeriod:2016.08.01;
endPeriod:2016.08.12;
start6Mo:2016.08.01;
maxTradeDate:exec max TradeDate from price;
maxTradeDateMinus3Years:maxTradeDate-3*365;

/ helpers from load.a, copied as they are:
/ getMonth: month number 1..12;  getYear: the year as a number
getMonth:{1 + (`month$x) mod 12};
getYear:{`year$x};
/ firstDateOfYear and getWeek: week number counted from the start of the year
firstDateOfYear:{`date$`month$d-30*-1+getMonth d:`date$`month$x};
getWeek:{1 + floor (x - firstDateOfYear x)%7};
/ float: turn a number into a float
float:{`float$x};
</q>

// === query: Appendix B, Q0 ===
// Copied from AQueryKDB src/test/financial/Q0.a (same as the paper).
<q>
constWeekly:{(count x)#`weekly};
constMonthly:{(count x)#`monthly};
constYearly:{(count x)#`yearly};
</q>


WITH
 // our main source of information, localized, avoiding rerunning for each aggregation
 Target(Id, TradeDate, ClosePrice)  AS (select
 Id, TradeDate,ClosePrice
 FROM price
 where Id in stock10 and TradeDate >= startYear10 and TradeDate <= startYear10 + 365 * 10)

  weekly(Id, bucket, name, low, high, mean) AS (select
    Id,
    timeBucket,
    constWeekly(Id),
    min(ClosePrice),
	  max(ClosePrice), avg(ClosePrice)
  	from Target group by Id, getWeek(TradeDate) as timeBucket)

  monthly(Id, bucket, name, low, high, mean) AS (select
    Id,
    timeBucket,
    constMonthly(Id),
     min(ClosePrice),
	   max(ClosePrice),
     avg(ClosePrice)
  	 from Target group by Id, getMonth(TradeDate) as timeBucket)

  yearly(Id, bucket, name, low, high, mean) AS (select
    Id,
    timeBucket,
    constYearly(Id),
     min(ClosePrice),
	   max(ClosePrice),
     avg(ClosePrice)
  	 from Target group by Id, getYear(TradeDate) as timeBucket)

select Id, bucket, name, low, high, mean from CONCATENATE(weekly, monthly, yearly)
    assuming asc Id, asc name, asc bucket
// Rows: one per stock and week, month or year it trades in: 41,
// counted separately with plain q.
// expect: 41

// === query: Appendix B, Q1 ===
// Copied from AQueryKDB src/test/financial/Q1.a (same as the paper).
WITH
  pxdata(Id, TradeDate, HighPrice, LowPrice, ClosePrice, OpenPrice, Volume) AS (
    SELECT Id, TradeDate, HighPrice, LowPrice, ClosePrice, OpenPrice, Volume
    FROM price
    WHERE Id IN stock1000
      AND TradeDate >= start300Days
      AND TradeDate <= start300Days + 300
  )

  splitdata(Id, SplitDate, SplitFactor) AS (
    SELECT Id, SplitDate, SplitFactor
    FROM split
    WHERE Id IN stock1000
      AND SplitDate >= start300Days
  )

  adjdata(Id, TradeDate, AdjFactor) AS (
    SELECT Id, TradeDate, prd(SplitFactor)
    FROM pxdata INNER JOIN splitdata USING Id
    WHERE TradeDate < SplitDate
    GROUP BY Id, TradeDate
  )

SELECT
  Id,
  TradeDate,
  HighPrice * fill(1, AdjFactor),
  LowPrice * fill(1, AdjFactor),
  ClosePrice * fill(1, AdjFactor),
  OpenPrice * fill(1, AdjFactor),
  Volume / fill(1, AdjFactor)
FROM pxdata FULL OUTER JOIN adjdata USING (Id, TradeDate)
ASSUMING ASC Id, ASC TradeDate
// stock1000 is A, B, C: 11 days each from 08/01/2016 to 02/01/2017.
// A's prices before its split (08/05/2016) are doubled, C's before
// 08/10/2016 tripled; volumes are divided the same way.
// expect: 33

// === query: Appendix B, Q2 ===
// Copied from AQueryKDB src/test/financial/Q2.a (same as the paper).
WITH
  pxdata(Id, TradeDate, HighPrice, LowPrice) AS (
    SELECT Id, TradeDate, HighPrice, LowPrice
    FROM price
    WHERE Id IN stock1000
      AND TradeDate BETWEEN startPeriod AND endPeriod
  )

  splitdata(Id, TradeDate, SplitFactor) AS (
    SELECT Id, SplitDate, SplitFactor
    FROM split
    WHERE Id IN stock1000
      AND SplitDate BETWEEN startPeriod AND endPeriod
  )

SELECT Id, TradeDate, HighPrice - LowPrice AS MaxDiff
FROM pxdata INNER JOIN splitdata USING (Id, TradeDate)
ASSUMING ASC Id, ASC TradeDate
// The split days: A on 08/05/2016 and C on 08/10/2016, High - Low = 2.
// expect: ([] Id:`A`C; TradeDate:2016.08.05 2016.08.10; MaxDiff:2 2f)

// === query: Appendix B, Q3 ===
// Copied from AQueryKDB src/test/financial/Q3.a (same as the paper).
SELECT avg(ClosePrice) AS avg_close_price
FROM price
WHERE Id IN SP500
  AND TradeDate = startPeriod
// SP500 is A, B. On 08/01/2016 they close at 10 and 20: average 15.
// expect: ([] a:enlist 15f)

// === query: Appendix B, Q4 ===
// Copied from AQueryKDB src/test/financial/Q4.a (same as the paper).
SELECT avg(ClosePrice) AS avg_close_price
FROM price
WHERE Id IN Russell2000
  AND TradeDate = startPeriod
// Russell2000 is B, C, D. On 08/01/2016: 20, 30, 40, average 30.
// expect: ([] a:enlist 30f)

// === query: Appendix B, Q5 ===
// Copied from AQueryKDB src/test/financial/Q5.a (same as the paper).
WITH
  pxdata(Id, TradeDate, ClosePrice) AS (
    SELECT Id, TradeDate, ClosePrice
    FROM price
    WHERE Id IN stock1000
      AND TradeDate >= start6Mo
      AND TradeDate < start6Mo + 31 * 6
  )

  splitdata(Id, SplitDate, SplitFactor) AS (
    SELECT Id, SplitDate, SplitFactor
    FROM split
    WHERE Id IN stock1000
      AND SplitDate >= start6Mo
  )

  splitadj(Id, TradeDate, ClosePrice) AS (
    SELECT Id, TradeDate, first(ClosePrice * prd(SplitFactor))
    FROM pxdata INNER JOIN splitdata USING Id
    WHERE TradeDate < SplitDate
    GROUP BY Id, TradeDate
  )

  avgInfo(Id, TradeDate, ClosePrice, m21, m5) AS (
    SELECT
      Id,
      TradeDate,
      fill(pxdata.ClosePrice, splitadj.ClosePrice),
      avgs(21, fill(pxdata.ClosePrice, splitadj.ClosePrice)),
      avgs(5, fill(pxdata.ClosePrice, splitadj.ClosePrice))
    FROM pxdata FULL OUTER JOIN splitadj USING (Id, TradeDate)
    ASSUMING ASC Id, ASC TradeDate
    GROUP BY Id
  )

SELECT *
FROM FLATTEN(avgInfo)
ASSUMING ASC Id, ASC TradeDate
// expect: 33

// === query: Appendix B, Q6 ===
// Copied from AQueryKDB src/test/financial/Q6.a (same as the paper).
WITH
  pxdata(Id, TradeDate, ClosePrice) AS (
    SELECT Id, TradeDate, ClosePrice
    FROM price
    WHERE Id IN stock1000
      AND TradeDate >= start6Mo
      AND TradeDate < start6Mo + 31 * 6
  )

  splitdata(Id, SplitDate, SplitFactor) AS (
    SELECT Id, SplitDate, SplitFactor
    FROM split
    WHERE Id IN stock1000
      AND SplitDate >= start6Mo
  )

  splitadj(Id, TradeDate, ClosePrice) AS (
    SELECT Id, TradeDate, first(ClosePrice * prd(SplitFactor))
    FROM pxdata INNER JOIN splitdata USING Id
    WHERE TradeDate < SplitDate
    GROUP BY Id, TradeDate
  )

  avgInfo(Id, TradeDate, ClosePrice, m21, m5) AS (
    SELECT
      Id,
      TradeDate,
      fill(pxdata.ClosePrice, splitadj.ClosePrice),
      avgs(21, fill(pxdata.ClosePrice, splitadj.ClosePrice)),
      avgs(5, fill(pxdata.ClosePrice, splitadj.ClosePrice))
    FROM pxdata FULL OUTER JOIN splitadj USING (Id, TradeDate)
    ASSUMING ASC Id, ASC TradeDate
    GROUP BY Id
  )

SELECT Id, TradeDate AS CrossDate, ClosePrice
FROM FLATTEN(avgInfo)
WHERE Id = prev(Id)
  AND or(
    prev(m5) <= prev(m21) & m5 > m21,
    prev(m5) >= prev(m21) & m5 < m21
  )
// Checked by hand: the 5-row average first drops below the 21-row
// average on these days (and for B rises above it again on 08/12).
// expect: ([] Id:`A`B`B`C; CrossDate:2016.08.08 2016.08.08 2016.08.12 2016.08.09; ClosePrice:13 17 21 90f)

// === query: Appendix B, Q7 ===
// Copied from AQueryKDB src/test/financial/Q7.a (same as the paper).
FUNCTION executeStrategy(alloc, mavgday, mavgmonth, px) {
  buySignal := mavgday > mavgmonth;
  alloc * prd(
    CASE maxs(buySignal)
      WHEN TRUE THEN
        CASE buySignal
          WHEN TRUE THEN 1 / px
          ELSE px
        END
      ELSE 1
    END
  )
}

WITH
  pxdata(Id, TradeDate, ClosePrice) AS (
    SELECT Id, TradeDate, ClosePrice
    FROM price
    WHERE Id IN stock10
      AND TradeDate >= max(TradeDate) - 365
  )

  splitdata(Id, SplitDate, SplitFactor) AS (
    SELECT Id, SplitDate, SplitFactor
    FROM split
    WHERE Id IN stock10
      AND SplitDate >= max(SplitDate) - 365
  )

  splitadj(Id, TradeDate, ClosePrice) AS (
    SELECT Id, TradeDate, first(ClosePrice * prd(SplitFactor))
    FROM pxdata INNER JOIN splitdata USING Id
    WHERE TradeDate < SplitDate
    GROUP BY Id, TradeDate
  )

  adjpxdata(Id, TradeDate, ClosePrice) AS (
    SELECT Id, TradeDate, fill(pxdata.ClosePrice, splitadj.ClosePrice) AS ClosePrice
    FROM pxdata FULL OUTER JOIN splitadj USING (Id, TradeDate)
  )

  movingAvgs(Id, TradeDate, ClosePrice, m21day, m5month) AS (
    SELECT
      Id,
      TradeDate,
      ClosePrice,
      avgs(21, ClosePrice),
      avgs(160, ClosePrice)
    FROM adjpxdata
    ASSUMING ASC Id, ASC TradeDate
    GROUP BY Id
  )

  simulated(Id, result, stillInvested) AS (
    SELECT
      Id,
      executeStrategy(10000, m21day, m5month, ClosePrice),
      last(m21day) > last(m5month)
    FROM FLATTEN(movingAvgs)
    WHERE Id = prev(Id)
      AND or(
        prev(m5month) <= prev(m21day) & m5month > m21day,
        prev(m5month) >= prev(m21day) & m5month < m21day
      )
    GROUP BY Id
  )

  latestPxs AS (
    SELECT *
    FROM adjpxdata
    WHERE TradeDate = max(TradeDate)
  )

SELECT sum(fill(10000, result * CASE WHEN stillInvested THEN ClosePrice ELSE 1 END)) AS stock_value
FROM latestPxs FULL OUTER JOIN simulated USING Id
// Checked against the authors' own hand-written q for Q7
// (financial/l_query/Q7_1.q, .kdb.q7) run on the same data.
// (27352.94 on this data.)
// expect: {system "l ",.aqc.root,"/tests/paper/kdb_q7_reference.q"; .kdb.q7[]}[]

// === query: Appendix B, Q8 ===
// Copied from AQueryKDB src/test/financial/Q8.a (same as the paper).
FUNCTION covariance(x, y) {
  xmean := avg(x);
  ymean := avg(y);
  avg((x - xmean) * (y - ymean))
}

FUNCTION sd(x) {
  sqrt(covariance(x, x))
}

FUNCTION pairCorr(x, y) {
  covariance(x, y) / (sd(x) * sd(y))
}

<q>pairCorrEach:pairCorr'</q>

<q>
/ Original Q8 time window. Restore these predicates if you want the old
/ benchmark range:
/   AND TradeDate >= startYear10
/   AND TradeDate <= startYear10 + 365 * 2
</q>

WITH
  stocksGrouped(Id, ClosePrice) AS (
    SELECT Id, ClosePrice
    FROM price
    ASSUMING ASC Id, ASC TradeDate
    WHERE Id IN stock10
      AND TradeDate >= startPeriod
      AND TradeDate <= startPeriod + 3
    GROUP BY Id
  )

  pairsGrouped(Id1, Id2, ClosePrice1, ClosePrice2) AS (
    SELECT
      st1.Id,
      st2.Id,
      st1.ClosePrice,
      st2.ClosePrice
    FROM stocksGrouped st1, stocksGrouped st2
  )

  corrTable(Id1, Id2, corrCoeff) AS (
    SELECT Id1, Id2, pairCorrEach(ClosePrice1, ClosePrice2)
    FROM pairsGrouped
    WHERE Id1 != Id2
  )

SELECT *
FROM corrTable
ASSUMING ASC corrCoeff
// 3 stocks give 6 ordered pairs. A rises while B falls: -1.
// expect: 6

// === query: Appendix B, Q9 ===
// Copied from AQueryKDB src/test/financial/Q9.a (same as the paper).
<q>
q9StartDate:{maxTradeDateMinus3Years};
q9StartYear:{getYear maxTradeDateMinus3Years};
q9SplitIds:{exec distinct Id from split where Id in Russell2000, getYear[SplitDate] >= getYear maxTradeDateMinus3Years};
</q>

WITH

  nosplit_avgpx(Id, year, avg_px) AS (
    SELECT Id, year, avg(ClosePrice)
    FROM price
    WHERE Id IN Russell2000
      AND TradeDate >= q9StartDate()
      AND Id NOT IN q9SplitIds()
    GROUP BY Id, getYear(TradeDate)
      AS year
  )

  divdata(Id, year, total_divs) AS (
    SELECT Id, year, sum(DivAmt)
    FROM dividend
    WHERE Id IN Russell2000
      AND getYear(AnnounceDate) >= q9StartYear()
      AND Id NOT IN q9SplitIds()
    GROUP BY Id, getYear(AnnounceDate)
      AS year
  )

SELECT
  Id,
  year,
  float(avg_px) AS avg_px,
  float(total_divs) AS total_divs,
  float(total_divs / avg_px) AS yield
FROM nosplit_avgpx INNER JOIN divdata USING (Id, year)
// C split, so only B and D remain. Matches on (Id, year):
// B 2015 (avg 21.5, divs 0.4), B 2016 (18.5, 0.5), D 2016 (40.5, 1.0).
// expect: 3

