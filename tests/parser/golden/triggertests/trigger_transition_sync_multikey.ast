  - Trigger @12:1
    name: "trg_sync_table2_multikey"
    time: After
    event: UpdateEvent
    table: "table1"
    refs: List
      - TriggerRef
        kind: NewTableRef
        alias: "inserted"
    body: Update @15:4
      t: "table2"
      assigns: List
        - Tuple
          _1: "qty"
          _2: ColumnAccess @16:14
            t: "inserted"
            c: "qty"
        - Tuple
          _1: "note"
          _2: ColumnAccess @16:35
            t: "inserted"
            c: "note"
      order: []
      where: List
