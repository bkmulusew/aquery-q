          l: ColumnAccess @17:10
            t: "table2"
            c: "id"
          r: ColumnAccess @17:22
            t: "inserted"
            c: "id"
        - BinExpr @17:38
          op: Eq
          l: ColumnAccess @17:38
            t: "table2"
            c: "subid"
          r: ColumnAccess @17:53
            t: "inserted"
            c: "subid"
      groupby: []
      having: []
  - Update @19:1
