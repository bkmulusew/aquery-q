List
  - Create @1:1
    n: "table1"
    source: Left
      value: List
        - Tuple
          _1: "id"
          _2: TypeInt
        - Tuple
          _1: "delta"
          _2: TypeInt
        - Tuple
          _1: "limit"
          _2: TypeInt
  - Create @2:1
    n: "table2"
    source: Left
      value: List
        - Tuple
          _1: "id"
          _2: TypeInt
        - Tuple
          _1: "qty"
          _2: TypeInt
        - Tuple
          _1: "note"
          _2: TypeString
  - Insert @4:1
    n: "table1"
    order: []
    modifier: []
    src: Left
      value: List
        - IntLit @4:27
          v: 1
        - IntLit @4:30
          v: 5
        - IntLit @4:33
          v: 20
  - Insert @5:1
    n: "table1"
    order: []
    modifier: []
    src: Left
      value: List
