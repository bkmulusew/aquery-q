List
  - Query @1:1
    local: []
    main: Project @1:1
      t: Filter
        t: Table @2:6
          n: "orders"
          alias: None
        fs: List
          - BinExpr @3:7
            op: Eq
            l: Id @3:7
              v: "storeid"
            r: StringLit @3:17
              v: "10"
      ps: List
        - Tuple
          _1: FunCall @1:8
            f: "SUM"
            args: List
              - BinExpr @1:12
                op: Times
                l: Id @1:12
                  v: "quantity"
                r: Id @1:23
                  v: "price"
          _2: Some
            value: "amount"
