List
  - Query @1:1
    local: []
    main: Project @1:1
      t: Filter
        t: Table @2:6
          n: "storeOutstanding"
          alias: None
        fs: List
          - BinExpr @3:7
            op: Eq
            l: Id @3:7
              v: "storeid"
            r: StringLit @3:17
