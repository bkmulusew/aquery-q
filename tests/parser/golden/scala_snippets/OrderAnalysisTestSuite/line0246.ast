List
  - Query @1:1
    local: []
    main: Project @1:1
      t: Filter
        t: SortBy
          t: Table @1:15
            n: "t"
            alias: None
          os: List
            - Tuple
              _1: Asc
              _2: Id @1:30
                v: "c1"
            - Tuple
              _1: Desc
              _2: ColumnAccess @1:39
                t: "t"
                c: "c2"
        fs: List
          - BinExpr @1:50
            op: Gt
            l: Id @1:50
              v: "c1"
            r: IntLit @1:55
              v: 2
      ps: List
        - Tuple
          _1: WildCard
          _2: None
