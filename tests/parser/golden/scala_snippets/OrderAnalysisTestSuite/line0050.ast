List
  - UDF @1:1
    n: "f"
    args: List
      - "x"
      - "y"
    cs: List
      - Left
        value: Assign
          n: "z"
          e: FunCall @1:25
            f: "MAX"
            args: List
              - FunCall @1:29
                f: "SUMS"
                args: List
                  - Id @1:34
                    v: "x"
      - Right
        value: BinExpr @1:39
          op: Plus
          l: Id @1:39
            v: "z"
          r: IntLit @1:43
            v: 2
