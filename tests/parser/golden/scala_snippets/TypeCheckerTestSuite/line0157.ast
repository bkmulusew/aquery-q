List
  - Query @1:1
    local: []
    main: Project @1:1
      t: Join @1:25
        jt: Cross
        l: Table @1:25
          n: "t"
          alias: Some
            value: "first_t"
        r: Table @1:39
          n: "t"
          alias: Some
            value: "second_t"
        cond: []
      ps: List
        - Tuple
          _1: BinExpr @1:8
            op: Times
            l: ColumnAccess @1:8
              t: "t"
              c: "c1"
            r: ColumnAccess @1:15
              t: "t"
              c: "c2"
          _2: None
