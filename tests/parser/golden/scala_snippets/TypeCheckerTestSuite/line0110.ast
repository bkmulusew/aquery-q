List
  - UDF @1:1
    n: "f"
    args: List
      - "x"
      - "y"
    cs: List
      - Right
        value: BinExpr @1:20
          op: Plus
          l: BinExpr @1:20
            op: Times
            l: Id @1:20
              v: "x"
            r: Id @1:24
              v: "y"
          r: IntLit @1:28
            v: 2
