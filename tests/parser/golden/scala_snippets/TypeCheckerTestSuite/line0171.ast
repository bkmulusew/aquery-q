List
  - Query @1:1
    local: []
    main: Project @1:1
      t: SortBy
        t: Table @1:15
          n: "t"
          alias: None
        os: List
          - Tuple
            _1: Asc
            _2: BinExpr @1:30
              op: Times
              l: Id @1:30
                v: "c2"
              r: IntLit @1:35
