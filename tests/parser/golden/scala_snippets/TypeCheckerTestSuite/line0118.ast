List
  - Query @1:1
    local: []
    main: Project @1:1
      t: Filter
        t: Table @1:15
          n: "t"
          alias: None
        fs: List
          - BinExpr @1:23
            op: Gt
            l: Id @1:23
              v: "c2"
            r: IntLit @1:28
              v: 3
          - BinExpr @1:34
            op: Times
            l: FunCall @1:34
