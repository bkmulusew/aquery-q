List
  - Query @1:1
    local: []
    main: Project @1:1
      t: Filter
        t: Table @1:18
          n: "t"
          alias: Some
            value: "first_t"
        fs: List
          - BinExpr @1:34
            op: Gt
            l: Id @1:34
              v: "c1"
            r: IntLit @1:39
              v: 2
      ps: List
        - Tuple
          _1: ColumnAccess @1:8
            t: "t"
            c: "c1"
          _2: None
