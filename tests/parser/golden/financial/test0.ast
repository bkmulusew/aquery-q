List
  - VerbatimCode @1:1
    c: "\nconstYearly:{(count x)#`yearly};\n"
  - Query
    local: List
      - Tuple
        _1: "Target"
        _2: List
          - "Id"
          - "TradeDate"
          - "ClosePrice"
        _3: Project
          t: Filter
            t: Table @8:10
              n: "price"
              alias: None
            fs: List
              - FunCall
                f: "IN"
                args: List
                  - Id @9:11
                    v: "Id"
                  - Id @9:17
                    v: "stock10"
              - BinExpr
                op: Ge
                l: Id @10:11
                  v: "TradeDate"
                r: Id @10:24
                  v: "startYear10"
              - BinExpr
                op: Le
                l: Id @11:11
                  v: "TradeDate"
                r: BinExpr
                  op: Plus
                  l: Id @11:24
                    v: "startYear10"
                  r: BinExpr
                    op: Times
                    l: IntLit @11:38
                      v: 365
                    r: IntLit @11:44
                      v: 10
          ps: List
            - Tuple
              _1: Id @7:12
                v: "Id"
              _2: None
            - Tuple
              _1: Id @7:16
                v: "TradeDate"
              _2: None
            - Tuple
              _1: Id @7:27
                v: "ClosePrice"
              _2: None
    main: Project
      t: GroupBy
        t: Table @21:6
          n: "Target"
          alias: None
        gs: List
          - Tuple
            _1: Id @22:10
              v: "Id"
            _2: None
          - Tuple
            _1: FunCall
              f: "getYear"
              args: List
                - Id @22:22
                  v: "TradeDate"
            _2: Some
              value: "timeBucket"
        having: []
      ps: List
        - Tuple
          _1: Id @15:3
            v: "Id"
          _2: None
        - Tuple
          _1: Id @16:3
            v: "timeBucket"
          _2: None
        - Tuple
          _1: FunCall
            f: "constYearly"
            args: List
              - Id @17:15
                v: "Id"
          _2: None
        - Tuple
          _1: FunCall
            f: "MIN"
            args: List
              - Id @18:7
                v: "ClosePrice"
          _2: None
        - Tuple
          _1: FunCall
            f: "MAX"
            args: List
              - Id @19:7
                v: "ClosePrice"
          _2: None
        - Tuple
          _1: FunCall
            f: "AVG"
            args: List
              - Id @20:7
                v: "ClosePrice"
          _2: None
