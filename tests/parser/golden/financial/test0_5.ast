              _2: None
            - Tuple
              _1: FunCall
                f: "AVG"
                args: List
                  - Id @44:16
                    v: "ClosePrice"
              _2: None
    main: Project
      t: SortBy
        t: BottomApply
          f: "CONCATENATE"
          args: List
            - Id @50:18
              v: "weekly"
            - Id @50:26
              v: "monthly"
            - Id @50:35
              v: "yearly"
        os: List
