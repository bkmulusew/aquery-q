CREATE TABLE t (a INT, b FLOAT, c STRING, d DATE, e TIMESTAMP, f BOOLEAN)
CREATE TABLE u SELECT a FROM t
INSERT INTO t VALUES(1, 2.0, "x")
INSERT INTO t (a, b) VALUES(1, 2.0)
INSERT INTO t VALUES(1)
INSERT INTO t ASSUMING ASC a SELECT * FROM u
INSERT INTO t (a) SELECT a FROM u
UPDATE t SET a = a + 1 WHERE b > 1
UPDATE t SET a = sums(b), b = 2 ASSUMING ASC a WHERE b > 1 GROUP BY c
UPDATE t SET a = 1 GROUP BY c HAVING count(a) > 1
UPDATE t SET a = 1
DELETE a, b FROM t
DELETE a FROM t
DELETE FROM t WHERE a > 1
DELETE FROM t
DELETE FROM t ASSUMING ASC b WHERE a > 1 GROUP BY c HAVING count(a) > 1
LOAD DATA INFILE "f.csv" INTO TABLE t FIELDS TERMINATED BY ","
SELECT a FROM t INTO OUTFILE "g.csv" FIELDS TERMINATED BY "|"
FUNCTION f(x, y) { z := x + y; z * 2 }
FUNCTION g() { 1 }
